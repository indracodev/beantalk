<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Protect Sensitive Files & Hidden Directories
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package(-lock)?\.json - [F,L,NC]
    RewriteRule ^phpunit\.xml - [F,L,NC]
    RewriteRule ^(storage|bootstrap/cache)/logs - [F,L,NC]
    RewriteRule ^(\.git|\.agents|\.vscode|\.idea) - [F,L,NC]

    # 2. Redirect Trailing Slashes If Not A Folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 3. Route All Requests to Public Directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent directory indexing
Options -Indexes
