{
    "private": true,
    "scripts": {
        "build": "npm run build:css && npm run build:sdk",
        "build:css": "tailwindcss -c tailwind.config.js -i resources/css/tailwind.css -o public/css/tailwind.css --minify",
        "watch:css": "tailwindcss -c tailwind.config.js -i resources/css/tailwind.css -o public/css/tailwind.css --watch",
        "build:fonts": "node scripts/build-fonts.mjs",
        "build:sdk": "node packages/chat-sdk/build.js"
    },
    "devDependencies": {
        "@fontsource/inter": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/plus-jakarta-sans": "^5.3.0",
        "tailwindcss": "^3.4.17"
    }
}
